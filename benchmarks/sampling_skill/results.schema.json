{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sampling skill study contribution",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["schema_version", "run_id", "trial_id", "provider", "model", "effort", "task", "condition", "repeat", "source_sha256", "skill_sha256", "harness_sha256", "usage", "quality", "status"],
    "properties": {
      "schema_version": {"const": 1},
      "run_id": {"type": "string", "minLength": 1},
      "trial_id": {"type": "string", "minLength": 1},
      "provider": {"type": "string", "minLength": 1},
      "model": {"type": "string", "minLength": 1},
      "effort": {"type": "string"},
      "task": {"type": "string", "minLength": 1},
      "condition": {"enum": ["baseline", "skill"]},
      "repeat": {"type": "integer", "minimum": 0},
      "source_sha256": {"$ref": "#/$defs/hash"},
      "skill_sha256": {"$ref": "#/$defs/hash"},
      "harness_sha256": {"$ref": "#/$defs/hash"},
      "status": {"enum": ["prepared", "finished", "timeout", "interrupted"]},
      "successful": {"type": "boolean"},
      "usage": {
        "anyOf": [
          {"type": "null"},
          {
            "type": "object",
            "required": ["input_tokens", "output_tokens", "total_tokens", "cache_read_tokens", "cache_write_tokens"],
            "properties": {
              "input_tokens": {"type": "integer", "minimum": 0},
              "output_tokens": {"type": "integer", "minimum": 0},
              "total_tokens": {"type": "integer", "minimum": 0},
              "cache_read_tokens": {"type": ["integer", "null"], "minimum": 0},
              "cache_write_tokens": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        ]
      },
      "quality": {
        "anyOf": [
          {"type": "null"},
          {"type": "object", "required": ["checks", "passed"], "properties": {
            "checks": {"type": "object"},
            "passed": {"type": "boolean"}
          }}
        ]
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
